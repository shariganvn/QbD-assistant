{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QbD evidence-bound rationale",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rationale_id", "packet_id", "packet_sha256", "run_id", "decision_id", "decision_sha256", "cohort_id", "decision_status", "winner", "fd_action", "display_state", "claims"],
  "properties": {
    "schema_version": { "const": 1 },
    "rationale_id": { "type": "string", "minLength": 1 },
    "packet_id": { "type": "string", "minLength": 1 },
    "packet_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "run_id": { "type": "string", "minLength": 1 },
    "decision_id": { "type": "string", "minLength": 1 },
    "decision_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cohort_id": { "type": "string", "minLength": 1 },
    "decision_status": { "type": "string", "minLength": 1 },
    "winner": { "type": ["string", "null"] },
    "fd_action": { "type": "string", "minLength": 1 },
    "display_state": { "const": "internal_only" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "kind", "text", "cites"],
        "properties": {
          "claim_id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["fact", "gate", "sensitivity", "exclusion", "decision_state"] },
          "text": { "type": "string", "minLength": 1 },
          "cites": { "type": "object" }
        }
      }
    }
  }
}
