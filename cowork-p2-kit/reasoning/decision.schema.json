{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QbD formula decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "status", "winner", "cohort_id", "fact_card_ids", "rubric_sha256", "fd_action", "linear_attestation_id", "linear_attestation_sha256", "cohort_basis"],
  "properties": {
    "schema_version": { "const": 2 },
    "decision_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["selected", "inconclusive"] },
    "winner": { "type": ["string", "null"] },
    "cohort_id": { "type": "string", "minLength": 1 },
    "fact_card_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rubric_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "fd_action": { "type": "string", "minLength": 1 },
    "linear_attestation_id": { "type": ["string", "null"], "minLength": 1 },
    "linear_attestation_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "cohort_basis": { "type": "string", "minLength": 1 }
  }
}
