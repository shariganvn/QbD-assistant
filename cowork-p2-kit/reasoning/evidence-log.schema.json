{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QbD reasoning evidence log",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cohort_id", "entries", "exclusions"],
  "properties": {
    "schema_version": { "const": 2 }, "cohort_id": { "type": "string", "minLength": 1 },
    "entries": { "type": "array", "items": { "type": "object", "additionalProperties": false,
      "required": ["record_id", "candidate", "fact_card_ids", "quote", "provenance"],
      "properties": { "record_id": { "type": "string", "minLength": 1 },
        "candidate": { "type": "string", "minLength": 1 }, "quote": { "type": "string", "minLength": 1 },
        "fact_card_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "provenance": { "type": "object", "additionalProperties": false, "required": ["file", "page", "char_start", "char_end"],
          "properties": { "file": { "type": "string", "minLength": 1 }, "page": { "type": "integer", "minimum": 1 }, "char_start": { "type": "integer", "minimum": 0 }, "char_end": { "type": "integer", "minimum": 1 } } }
      }
    } },
    "exclusions": { "type": "array", "items": { "type": "object", "additionalProperties": false,
      "required": ["scope", "candidate", "record_id", "reason"],
      "properties": { "scope": { "enum": ["candidate", "record"] }, "candidate": { "type": "string", "minLength": 1 },
        "record_id": { "type": ["string", "null"] }, "reason": { "type": "string", "pattern": "^E_[A-Z0-9_]+$" } },
      "oneOf": [
        { "properties": { "scope": { "const": "candidate" }, "record_id": { "type": "null" } } },
        { "properties": { "scope": { "const": "record" }, "record_id": { "type": "string", "minLength": 1 } } }
      ] } }
  }
}
