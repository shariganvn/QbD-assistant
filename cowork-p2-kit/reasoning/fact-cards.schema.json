{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QbD reasoning fact cards",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cards"],
  "properties": {
    "schema_version": { "const": 1 },
    "cards": { "type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "record_id", "candidate", "measure", "raw_text", "normalized_value", "unit", "quote", "char_start", "char_end", "provenance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "record_id": { "type": "string", "minLength": 1 },
        "candidate": { "type": "string", "minLength": 1 }, "measure": { "type": "string", "minLength": 1 },
        "raw_text": { "type": "string", "minLength": 1 }, "normalized_value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }, "quote": { "type": "string", "minLength": 1 },
        "char_start": { "type": "integer", "minimum": 0 }, "char_end": { "type": "integer", "minimum": 0 },
        "provenance": { "type": "object", "additionalProperties": false, "required": ["file"], "properties": { "file": { "type": "string", "minLength": 1 } } }
      }
    } }
  }
}
