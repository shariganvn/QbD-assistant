{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QbD linear-formulation attestation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attestation_id", "required_fields", "members", "api", "dosage_form", "product_target", "trial_context"],
  "properties": {
    "schema_version": { "const": 2 },
    "attestation_id": { "type": "string", "minLength": 1 },
    "required_fields": { "type": "array", "minItems": 5, "items": { "type": "string" } },
    "members": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate", "strength"],
        "properties": {
          "candidate": { "type": "string", "minLength": 1 },
          "strength": { "type": "string", "minLength": 1 }
        }
      }
    },
    "api": { "type": "string", "minLength": 1 },
    "dosage_form": { "type": "string", "minLength": 1 },
    "product_target": { "type": "string", "minLength": 1 },
    "trial_context": { "type": "string", "minLength": 1 }
  }
}
