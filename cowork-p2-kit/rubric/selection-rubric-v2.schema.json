{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QbD selection rubric v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rubric_id", "approval_state", "measures", "tie_threshold", "minimum_eligible_candidates"],
  "properties": {
    "schema_version": { "const": 2 },
    "rubric_id": { "type": "string", "minLength": 1 },
    "approval_state": { "enum": ["proposal", "test-approved"] },
    "measures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "critical", "direction", "canonical_unit", "raw_shape", "aggregation", "hard_gate", "score_map", "weight", "conflict_tolerance"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "critical": { "type": "boolean" },
          "direction": { "enum": ["higher-is-better", "lower-is-better"] },
          "canonical_unit": { "type": "string", "minLength": 1 },
          "raw_shape": { "enum": ["scalar", "list", "range"] },
          "aggregation": { "enum": ["identity", "mean", "midpoint"] },
          "hard_gate": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["operator", "threshold"],
                "properties": {
                  "operator": { "enum": ["<=", ">="] },
                  "threshold": { "type": "number" }
                }
              }
            ]
          },
          "score_map": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["operator", "threshold", "points"],
              "properties": {
                "operator": { "enum": ["<=", ">=", "<", ">"] },
                "threshold": { "type": "number" },
                "points": { "type": "number" }
              }
            }
          },
          "weight": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nominal", "min", "max"],
            "properties": {
              "nominal": { "type": "number", "minimum": 0 },
              "min": { "type": "number", "minimum": 0 },
              "max": { "type": "number", "minimum": 0 }
            }
          },
          "conflict_tolerance": { "type": "number", "minimum": 0 }
        }
      }
    },
    "tie_threshold": { "type": "number", "minimum": 0 },
    "minimum_eligible_candidates": { "type": "integer", "minimum": 2 }
  }
}
