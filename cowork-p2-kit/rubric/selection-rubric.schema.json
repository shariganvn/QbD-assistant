{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QbD selection rubric",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rubric_id", "measures", "unit_vocabulary", "aggregation_rule", "approved_sha256"],
  "properties": {
    "schema_version": { "const": 1 }, "rubric_id": { "type": "string", "minLength": 1 },
    "measures": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "unit_vocabulary": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "aggregation_rule": { "type": "string", "minLength": 1 }, "approved_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
  }
}
